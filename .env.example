# ==============================================================================
# MemoryVault Environment Variables Template
# Copy this file to .env.local for local development with live Supabase.
# DO NOT commit real secrets or private credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase API Credentials (Optional - Default is In-Memory Adapter)
# ------------------------------------------------------------------------------
# Your Supabase Project REST URL (found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (safe for browser usage with Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Privileged service role key (STRICTLY SERVER-SIDE ONLY - Never expose to client)
# Used by SupabaseMemoryRepository for administrative operations and audits
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Direct PostgreSQL Connection (Optional - For running migrations)
# ------------------------------------------------------------------------------
# Standard PostgreSQL URI format (found under Project Settings -> Database -> Connection string)
# Used by `npm run db:migrate` to execute 001, 002, 003 schema migrations directly.
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
